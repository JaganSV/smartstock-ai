# Database
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartstock
# Native default; docker-compose.yml overrides this to "db" in the backend service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Integration-test database (created by make db-create). Placeholder: use the real password locally.
TEST_DATABASE_URL=postgresql+psycopg://smartstock:change_me@localhost:5432/smartstock_test

# Backend
APP_ENV=local
LOG_LEVEL=INFO
JWT_SECRET=change_me_to_32+_random_bytes
# Token signing is HS256 only (fixed). The secret must be at least 32 bytes or the app refuses to start.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BYTES=1048576
# Demo-user passwords: used only by `make seed-users` (never by the running app). At least 12 characters.
SEED_USER_PASSWORD_ADMIN=change_me
SEED_USER_PASSWORD_MANAGER=change_me
SEED_USER_PASSWORD_ANALYST=change_me
SEED_USER_PASSWORD_EXECUTIVE=change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Recalculate analytics once when the backend starts (FR-B5). Unset: true for APP_ENV=local, else false.
RECALC_ON_STARTUP=true

# watsonx.ai (used from Phase 5; leave placeholders)
WATSONX_URL=https://<region>.ml.cloud.ibm.com
WATSONX_API_KEY=change_me
WATSONX_PROJECT_ID=change_me
WATSONX_API_VERSION=YYYY-MM-DD
WATSONX_CHAT_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_FALLBACK_CHAT_MODEL_ID=ibm/granite-4-h-small
WATSONX_EMBED_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
